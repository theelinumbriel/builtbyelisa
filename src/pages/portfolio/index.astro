---
import Base from '../../layouts/Base.astro';
import HandwrittenLabel from '../../components/HandwrittenLabel.astro';
import { softwareProjects, hardwareProjects, workInProgress } from '../../data/projects';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const resolveHref = (href: string) => (href.startsWith('/') ? base + href : href);
const resolveAsset = (path: string) => `${base}${path}`;
---

<Base title="Portfolio | Elisa Diop-Weyer">
  <section class="portfolio">
    <h1 class="title" style="view-transition-name: nav-portfolio"><HandwrittenLabel asset="portfolio" label="Portfolio" /></h1>

    <div class="columns">
      <section class="col" aria-labelledby="software-heading">
        <h2 id="software-heading" class="col-heading">Selected software &amp;c projects</h2>
        <ul class="list">
          {
            softwareProjects.map((p, i) => (
              <li class="proj">
                <div class="row">
                  <span class="label">
                    {/* keep the anchor's text content EXACTLY the name -- no surrounding
                        whitespace, or the underline bleeds into the trailing space */}
                    {p.href ? (
                      <a href={resolveHref(p.href)} target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>{p.name}</a>
                    ) : p.plain ? (
                      <span>{p.name}</span>
                    ) : (
                      <span class="u" title="coming soon">{p.name}</span>
                    )}
                    {p.subtitle && <span class="project-subtitle"> ({p.subtitle})</span>}
                  </span>
                  {p.rationale && (
                    <button class="why" type="button" aria-expanded="false" aria-controls={`sw-${i}`} aria-label="Show details">
                      <span class="caret" aria-hidden="true">›</span>
                    </button>
                  )}
                </div>
                {p.rationale && (
                  <div class="rationale" id={`sw-${i}`}>
                    <div class="rationale-inner">
                      {p.rationale.split(/\n\n/).map((paragraph) => <p>{paragraph}</p>)}
                    </div>
                  </div>
                )}
              </li>
            ))
          }
        </ul>

        <section class="work-in-progress" aria-labelledby="work-in-progress-title">
          <h3 id="work-in-progress-title">Work in Progress</h3>
          <ul class="list">
            {workInProgress.map((p) => (
              <li class="proj">
                <a href={resolveHref(p.href!)}>{p.name}</a>
                {p.course && <span class="project-subtitle"> ({p.course})</span>}
              </li>
            ))}
          </ul>
        </section>
      </section>

      <section class="col" aria-labelledby="hardware-heading">
        <h2 id="hardware-heading" class="col-heading">Selected hardware projects</h2>
        <ul class="list hardware-list">
          {
            hardwareProjects.map((p, i) => (
              <li class="proj hw-proj">
                <div class="row">
                  <span class="label">
                    <span>{p.name}</span>
                    {p.subtitle && <span class="project-subtitle"> ({p.subtitle})</span>}
                  </span>
                  <button class="why" type="button" aria-expanded="false" aria-controls={`hw-${i}`} aria-label="Show details">
                    <span class="caret" aria-hidden="true">›</span>
                  </button>
                </div>
                <div class="rationale" id={`hw-${i}`}>
                  <div class="rationale-inner">
                    <div class="hw-body">
                      <div class="hw-text">
                        {p.rationale && <p>{p.rationale}</p>}
                        {p.media?.repo && (
                          <p class="hw-repo"><a href={p.media.repo} target="_blank" rel="noopener">repo</a></p>
                        )}
                      </div>
                      {p.media && (
                        <div class="hw-video">
                          <div class="player" data-player>
                            <video
                              class="clip"
                              src={resolveAsset(p.media.video)}
                              poster={resolveAsset(p.media.poster)}
                              preload="metadata"
                              muted
                              loop
                              playsinline
                              aria-label={p.media.alt}
                            ></video>
                            <button class="sound" type="button" data-sound aria-pressed="false" aria-label="Turn sound on">
                              <span class="sound-icon" aria-hidden="true" data-sound-icon>
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                  <path d="M11 5 6 9H2v6h4l5 4z"></path>
                                  <line x1="23" y1="9" x2="17" y2="15"></line>
                                  <line x1="17" y1="9" x2="23" y2="15"></line>
                                </svg>
                              </span>
                            </button>
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </section>
</Base>

<script>
  // wire hover-to-play on every (SPA) page-load; survive view-transition navigations.
  const wirePlayers = () => {
    document.querySelectorAll<HTMLElement>('[data-player]').forEach((player) => {
      if ((player.dataset as DOMStringMap).wired === '1') return;
      (player.dataset as DOMStringMap).wired = '1';

      const video = player.querySelector('video') as HTMLVideoElement | null;
      const btn = player.querySelector('[data-sound]') as HTMLButtonElement | null;
      if (!video || !btn) return;

      const start = () => {
        const p = video.play();
        if (p && typeof p.catch === 'function') p.catch(() => {});
      };
      const stop = () => {
        video.pause();
        try { video.currentTime = 0; } catch {}
      };

      player.addEventListener('mouseenter', start);
      player.addEventListener('mouseleave', stop);
      player.addEventListener('focusin', start);
      player.addEventListener('focusout', stop);
      player.addEventListener('touchstart', () => {
        if (video.paused) start(); else stop();
      }, { passive: true });

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const nextMuted = !video.muted;
        video.muted = nextMuted;
        btn.setAttribute('aria-pressed', String(!nextMuted));
        btn.setAttribute('aria-label', nextMuted ? 'Turn sound on' : 'Turn sound off');
        const icon = btn.querySelector('[data-sound-icon]');
        if (icon) {
          icon.innerHTML = nextMuted
            ? '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4z"></path><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>'
            : '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4z"></path><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>';
        }
      });
    });
  };
  wirePlayers();
  document.addEventListener('astro:page-load', wirePlayers);
</script>

<style>
  .portfolio {
    padding-top: 0.5rem;
  }

  .columns {
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
  }
  @media (min-width: 980px) {
    .columns {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 3rem;
      align-items: start;
    }
  }

  .col { min-width: 0; }

  .col-heading {
    font-style: italic;
    font-weight: 400;
    font-size: 1rem;
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    max-width: 42rem;
  }

  .proj { margin: 0; }

  .work-in-progress {
    margin-top: 2.25rem;
  }
  .work-in-progress h3 {
    font-style: italic;
    font-weight: 400;
    font-size: 1rem;
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }

  @media (hover: hover) and (pointer: fine) {
    .proj {
      transition: opacity 0.25s ease;
    }
    .list:has(.proj:hover) .proj:not(:hover) {
      opacity: 0.35;
    }
  }

  .row {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    line-height: 1.5;
  }

  .why {
    font: inherit;
    font-style: italic;
    color: var(--muted);
    background: none;
    border: 0;
    padding: 0;
    margin-left: auto;
    flex: none;
    white-space: nowrap;
    cursor: pointer;
    line-height: 1;
  }
  .why:hover { color: var(--fg); }
  .caret {
    display: inline-block;
    margin-left: 0.25rem;
    font-style: normal;
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .proj[data-open] .caret { transform: rotate(90deg); }

  .rationale {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.36s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .proj[data-open] .rationale { grid-template-rows: 1fr; }
  @supports (interpolate-size: allow-keywords) {
    .rationale {
      display: block;
      interpolate-size: allow-keywords;
      height: 0;
      overflow: clip;
      transition: height 0.36s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .proj[data-open] .rationale { height: auto; }
  }
  .rationale-inner { overflow: hidden; }
  .rationale-inner p {
    margin: 0;
    padding: 0.6rem 0 0.9rem;
    max-width: 42rem;
    color: var(--muted);
    line-height: 1.5;
    opacity: 0;
    transition: opacity 0.28s ease;
  }
  .label { min-width: 0; }
  .project-subtitle { color: var(--muted); }

  .proj[data-open] .rationale-inner p {
    opacity: 1;
    transition-delay: 0.08s;
  }

  @media (prefers-reduced-motion: reduce) {
    .caret,
    .rationale,
    .rationale-inner p { transition: none; }
  }

  /* hardware: text left, video right; repo link under the text */
  .hw-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    padding-top: 0.3rem;
  }
  .hw-text p { padding-top: 0.3rem; }
  .hw-text .hw-repo {
    padding: 0 0 0.3rem;
    font-style: italic;
  }
  .hw-text .hw-repo a { color: var(--muted); }
  .hw-text .hw-repo a:hover { color: var(--fg); }
  .proj[data-open] .hw-text .hw-repo { opacity: 1; transition-delay: 0.08s; }

  .hw-video { flex: none; }
  .player {
    position: relative;
    display: inline-block;
    line-height: 0;
    cursor: pointer;
  }
  .clip {
    display: block;
    width: 180px;
    max-width: 100%;
    height: auto;
    background: #000;
  }
  .sound {
    position: absolute;
    right: 0.4rem;
    bottom: 0.4rem;
    width: 2rem;
    height: 2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.55);
    color: #fff;
    cursor: pointer;
    opacity: 0;
    transition: opacity 0.2s ease;
    padding: 0;
  }
  .player:hover .sound,
  .player:focus-within .sound { opacity: 1; }
  .sound:hover { background: rgba(0, 0, 0, 0.75); }
  .sound-icon { display: inline-flex; }

  @media (max-width: 520px) {
    .hw-body {
      grid-template-columns: minmax(0, 1fr);
    }
    .clip { width: 100%; max-width: 320px; }
  }
</style>
