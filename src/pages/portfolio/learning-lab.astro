    max-width: 46rem;
  }

  .ll header {
    margin-bottom: 1.8rem;
  }

  .meta {
    color: var(--muted);
    font-style: italic;
  }

  .lede {
    font-style: italic;
    margin-bottom: 1.4rem;
  }

  .ll section {
    margin-bottom: 1.8rem;
  }

  .course {
    font-weight: 400;
    font-size: 1rem;
    font-style: italic;
    margin-bottom: 0.4rem;
  }

  .ll ul {
    margin: 0.6rem 0 0;
    padding-left: 1.4rem;
  }

  .ll li {
    margin-bottom: 0.6rem;
  }

  .back {
    margin-top: 2.5rem;
  }
</style>
