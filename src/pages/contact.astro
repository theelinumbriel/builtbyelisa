---
import Base from '../layouts/Base.astro';
---

<Base title="Contact | Elisa Diop-Weyer">
  <section class="contact">
    <div class="block">
      <h1 class="title" style="view-transition-name: nav-contact">Contact</h1>
      <p>Email: elisadiopweyer at college dot harvard dot edu</p>
      <p>
        GitHub: <a href="https://github.com/theelinumbriel" target="_blank" rel="noopener"
          >theelinumbriel</a
        >
      </p>
    </div>
  </section>
</Base>

<style>
  /* title sits top-left so the menu morph lands consistently across pages */
  .block {
    max-width: 46rem;
  }

  .block .title {
    /* one full grid line, so the paragraphs sit on the baseline grid */
    margin-bottom: 1.5rem;
  }

  .block p {
    margin: 0;
    line-height: 1.5;
  }
</style>
