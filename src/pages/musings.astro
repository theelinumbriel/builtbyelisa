---
import HandwrittenLabel from '../components/HandwrittenLabel.astro';
import Base from '../layouts/Base.astro';
---

<Base title="Musings | Elisa Diop-Weyer" description="Selected inputs and outputs from Elisa Diop-Weyer's text practice.">
  <section class="musings-page">
    <h1 class="title" style="view-transition-name: nav-musings"><HandwrittenLabel asset="musings" label="Musings" /></h1>

    <div class="musings-split">
      <section class="musings-column inputs" aria-labelledby="inputs-heading">
        <header>
          <h2 id="inputs-heading">Selected Inputs</h2>
          <p class="updated-date">updated: 20261005</p>
        </header>
        <div class="musings-field" aria-label="Selected inputs list">
          <ul class="inputs-list">
            <li>
              <a href="https://en.wikipedia.org/wiki/Mating_(novel)" target="_blank" rel="noreferrer">
                <cite>Mating</cite>
                <span>Norman Rush</span>
              </a>
            </li>
            <li>
              <a href="https://en.wikipedia.org/wiki/Mortals_(novel)" target="_blank" rel="noreferrer">
                <cite>Mortals</cite>
                <span>Norman Rush</span>
              </a>
            </li>
            <li>
              <a href="https://ia601408.us.archive.org/14/items/in.ernet.dli.2015.233884/2015.233884.The-Division.pdf" target="_blank" rel="noreferrer">
                <cite>The Division of Labor in Society</cite>
                <span>Émile Durkheim</span>
              </a>
            </li>
            <li>
              <a href="https://www.paulkingsnorth.net/against-machine" target="_blank" rel="noreferrer">
                <cite>Against the Machine</cite>
                <span>Paul Kingsnorth</span>
              </a>
            </li>
            <li>
              <a href="https://en.wikipedia.org/wiki/American_Prometheus" target="_blank" rel="noreferrer">
                <cite>American Prometheus</cite>
                <span>Kai Bird and Martin J. Sherwin</span>
              </a>
            </li>
            <li>
              <a href="https://en.wikipedia.org/wiki/2001:_A_Space_Odyssey" target="_blank" rel="noreferrer">
                <cite>2001: A Space Odyssey</cite>
                <span>Stanley Kubrick</span>
              </a>
            </li>
            <li class="input-with-pages">
              <div class="input-heading">
                <cite>Le dernier homme</cite>
                <span>from <cite>Ainsi parlait Zarathoustra</cite> · Friedrich Nietzsche</span>
              </div>
              <div class="input-pages" aria-label="Le dernier homme pages">
                <a href="https://fr.wikisource.org/wiki/Page:Nietzsche_-_Ainsi_parlait_Zarathoustra_(trad._Albert,_1903).djvu/17" target="_blank" rel="noreferrer">Page 17</a>
                <a href="https://fr.wikisource.org/wiki/Page:Nietzsche_-_Ainsi_parlait_Zarathoustra_(trad._Albert,_1903).djvu/18" target="_blank" rel="noreferrer">Page 18</a>
                <a href="https://fr.wikisource.org/wiki/Page:Nietzsche_-_Ainsi_parlait_Zarathoustra_(trad._Albert,_1903).djvu/19" target="_blank" rel="noreferrer">Page 19</a>
              </div>
            </li>
            <li>
              <a href="https://thedutyofthemoment.substack.com/p/moral-agency-is-proper-to-persons" target="_blank" rel="noreferrer">
                <cite>Moral Agency Is Proper to Persons, Not Machines</cite>
                <span>Erika Bachiochi · The Duty of the Moment</span>
              </a>
            </li>
            <li class="input-excerpt">
              <div class="input-heading">
                <a class="input-excerpt-title" href="https://book.stevejobsarchive.com/" target="_blank" rel="noreferrer"><cite>Email from Steve to Himself</cite></a>
                <span>Steve Jobs · September 2, 2010</span>
              </div>
              <p class="email-subject">[No Subject]</p>
              <dl class="email-meta">
                <dt>From:</dt><dd>Steve Jobs</dd>
                <dt>To:</dt><dd>Steve Jobs</dd>
                <dt>Subject:</dt><dd></dd>
                <dt>Date:</dt><dd>September 2, 2010, 11:08 p.m.</dd>
              </dl>
              <blockquote>
                <p>I grow little of the food I eat, and of the little I do grow I did not breed or perfect the seeds.</p>
                <p>I do not make any of my own clothing.</p>
                <p>I speak a language I did not invent or refine.</p>
                <p>I did not discover the mathematics I use.</p>
                <p>I am protected by freedoms and laws I did not conceive of or legislate, and do not enforce or adjudicate.</p>
                <p>I am moved by music I did not create myself.</p>
                <p>When I needed medical attention, I was helpless to help myself survive.</p>
                <p>I did not invent the transistor, the microprocessor, object oriented programming, or most of the technology I work with.</p>
                <p>I love and admire my species, living and dead, and am totally dependent on them for my life and well being.</p>
                <p>Sent from my iPad</p>
              </blockquote>
              <p class="excerpt-source">Excerpt from <a href="https://book.stevejobsarchive.com/" target="_blank" rel="noreferrer"><cite>Make Something Wonderful</cite></a> by Steve Jobs.</p>
            </li>
          </ul>
        </div>
      </section>

      <section class="musings-column outputs" aria-labelledby="outputs-heading">
        <header>
          <h2 id="outputs-heading">Selected Outputs</h2>
        </header>
        <div class="musings-field" aria-label="Selected outputs list"></div>
      </section>
    </div>
  </section>
</Base>

<style>
  .musings-page {
    min-height: calc(100vh - 8rem);
    display: grid;
    grid-template-rows: auto 1fr;
  }

  .musings-split {
    min-height: 0;
    margin-top: 1.5rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border-top: 1px solid rgba(0, 0, 0, 0.14);
    border-bottom: 1px solid rgba(0, 0, 0, 0.14);
  }

  .musings-column {
    min-height: clamp(24rem, 62vh, 48rem);
    display: grid;
    grid-template-rows: auto 1fr;
    padding: 1.5rem 0;
  }

  .musings-column + .musings-column {
    border-left: 1px solid rgba(0, 0, 0, 0.14);
    padding-left: var(--pad);
  }

  .musings-column:first-child {
    padding-right: var(--pad);
  }

  .musings-column header {
    min-height: 6rem;
  }

  .musings-column h2 {
    font-style: italic;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-thickness: 1px;
  }

  .updated-date {
    color: var(--muted);
    font-size: 0.8em;
  }

  .musings-field {
    display: flex;
    align-items: flex-end;
    padding-bottom: 0.15rem;
  }

  .inputs-list {
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .inputs-list li {
    border-top: 1px solid rgba(0, 0, 0, 0.14);
  }

  .inputs-list li:last-child {
    border-bottom: 1px solid rgba(0, 0, 0, 0.14);
  }

  .inputs-list > li > a,
  .input-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .inputs-list > li > a {
    padding: 0.65rem 0;
    color: inherit;
    text-decoration: none;
  }

  .inputs-list > li > a:hover cite,
  .inputs-list > li > a:focus-visible cite {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .inputs-list cite {
    font-style: italic;
  }

  .inputs-list span {
    flex: 0 0 auto;
    color: var(--muted);
    font-size: 0.9em;
    text-align: right;
  }

  .input-with-pages {
    padding: 0.65rem 0;
  }

  .input-pages {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  .input-pages a {
    color: var(--muted);
    font-size: 0.9em;
    text-underline-offset: 2px;
  }

  .input-excerpt {
    padding: 0.65rem 0 1rem;
  }

  .input-excerpt-title {
    color: inherit;
    text-decoration: none;
  }

  .input-excerpt-title:hover,
  .input-excerpt-title:focus-visible,
  .excerpt-source a:hover,
  .excerpt-source a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .email-subject {
    margin: 0.65rem 0 0;
    font-size: 0.9em;
  }

  .email-meta {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.05rem 0.5rem;
    margin: 0.4rem 0 0.85rem;
    color: var(--muted);
    font-size: 0.8em;
  }

  .email-meta dd {
    margin: 0;
  }

  blockquote {
    margin: 0;
    padding-left: 0.8rem;
    border-left: 1px solid rgba(0, 0, 0, 0.2);
    font-size: 0.9em;
    line-height: 1.45;
  }

  blockquote p {
    margin: 0 0 0.55rem;
  }

  blockquote p:last-child {
    margin-bottom: 0;
  }

  .excerpt-source {
    margin: 0.75rem 0 0;
    color: var(--muted);
    font-size: 0.8em;
  }

  .excerpt-source a {
    color: inherit;
  }

  @media (max-width: 700px) {
    .musings-split {
      grid-template-columns: 1fr;
    }

    .musings-column {
      min-height: 18rem;
    }

    .musings-column:first-child {
      padding-right: 0;
    }

    .musings-column + .musings-column {
      border-left: 0;
      border-top: 1px solid rgba(0, 0, 0, 0.14);
      padding-left: 0;
    }

    .inputs-list > li > a,
    .input-heading {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.15rem;
    }

    .inputs-list span {
      text-align: left;
    }
  }
</style>
