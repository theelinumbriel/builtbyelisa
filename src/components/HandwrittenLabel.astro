---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  asset: string;
  label: string;
  class?: string;
}

const { asset, label, class: className } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasHandwriting = existsSync(join(process.cwd(), 'public', 'handwriting', `${asset}.svg`));
---

<span class:list={['handwritten-label', className]} data-handwriting={asset}>
  {
    hasHandwriting ? (
      <img src={`${base}/handwriting/${asset}.svg`} alt={label} />
    ) : (
      <span>{label}</span>
    )
  }
  <svg class="handwritten-underline" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
    <path pathLength="1" d="M 1 3.9 C 17 2.3, 32 4.4, 49 3.1 S 81 2.1, 99 3.5" />
  </svg>
</span>
