---
import { existsSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  asset: string;
  label: string;
  class?: string;
}

const { asset, label, class: className } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const hasHandwriting = existsSync(join(process.cwd(), 'public', 'handwriting', `${asset}.svg`));
const fallbackSrc = `${base}/handwriting/${asset}.svg`;
// The Vercel build reads the current upload through a Function. Local and
// GitHub Pages builds retain the checked-in wordmarks as their complete source.
const src = import.meta.env.PROD && base === ''
  ? `/api/handwriting?slot=${encodeURIComponent(asset)}`
  : fallbackSrc;
---

<span class:list={['handwritten-label', className]} data-handwriting={asset}>
  {
    hasHandwriting ? (
      <img src={src} data-fallback-src={fallbackSrc} alt={label} />
    ) : (
      <span>{label}</span>
    )
  }
  <svg class="handwritten-underline" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
    <path pathLength="1" d="M 1 3.9 C 17 2.3, 32 4.4, 49 3.1 S 81 2.1, 99 3.5" />
  </svg>
</span>

<script>
  // If the storage Function is temporarily unavailable, the portfolio retains
  // the checked-in SVG rather than showing a broken wordmark.
  document.addEventListener('error', (event) => {
    const image = event.target as HTMLImageElement | null;
    if (!image?.matches('.handwritten-label img[data-fallback-src]')) return;
    const fallback = image.dataset.fallbackSrc;
    if (!fallback || image.src === new URL(fallback, location.href).href) return;
    image.src = fallback;
  }, true);
</script>
