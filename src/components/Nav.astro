---
interface Props {
  /** when true, each link carries a view-transition-name so the clicked word
      morphs into the destination page's title. Only the home hub opts in --
      the inner-page top bar must NOT, or names would collide on the page. */
  morph?: boolean;
}
const { morph = false } = Astro.props;

// base-aware links so the site works under the GitHub Pages subpath
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const links = [
  ['/portfolio', 'Portfolio'],
  ['/about', 'About'],
  ['/contact', 'Contact'],
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  path === base + href || path.startsWith(base + href + '/');
---
<nav class="nav">
  {
    links.map(([href, label]) => (
      <a
        href={base + href}
        aria-current={isActive(href) ? 'page' : undefined}
        style={morph ? `view-transition-name: nav-${label.toLowerCase()}` : undefined}
      >
        {label}
      </a>
    ))
  }
</nav>
