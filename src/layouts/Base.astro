---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import HandwrittenLabel from '../components/HandwrittenLabel.astro';
import Nav from '../components/Nav.astro';

interface Props {
  title?: string;
  description?: string;
  /** home hides the top bar and lets the page own the full viewport */
  home?: boolean;
  /** private utilities should not be indexed or followed */
  noindex?: boolean;
}

const {
  title = 'Elisa Diop-Weyer',
  description = 'Portfolio of Elisa Diop-Weyer',
  home = false,
  noindex = false,
} = Astro.props;

// base-aware asset/links so the site works under the GitHub Pages subpath
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow, noarchive" />}
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    {
      !home && (
        <header class="topbar">
          <a class="brand" href={`${base}/`}><HandwrittenLabel asset="elisa-diop-weyer" label="Elisa Diop-Weyer" /></a>
          <Nav />
        </header>
      )
    }
    <main>
      <slot />
    </main>

    {/* baseline-grid easter egg: press "g" to overlay the leading grid */}
    <div class="baseline-grid" hidden aria-hidden="true"></div>

    <script>
      // wired once on document; survives Astro view-transition (SPA) navigations.
      const w = window as unknown as { __emdwWired?: boolean };
      if (!w.__emdwWired) {
        w.__emdwWired = true;

        // portfolio: reveal a project's details (quiet accordion)
        document.addEventListener('click', (e) => {
          const btn = (e.target as HTMLElement).closest('.why') as HTMLButtonElement | null;
          if (!btn) return;
          const proj = btn.closest('.proj') as HTMLElement | null;
          if (!proj) return;
          const open = proj.toggleAttribute('data-open');
          btn.setAttribute('aria-expanded', String(open));
        });

        // portfolio: hover-to-play on hardware videos. document-level delegation
        // so it works on fresh page load, after view-transition navigation, and
        // without caring when the <video> elements render.
        const SPEAKER_MUTED = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4z"></path><line x1="23" y1="9" x2="17" y2="15"></line><line x1="17" y1="9" x2="23" y2="15"></line></svg>';
        const SPEAKER_ON = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 5 6 9H2v6h4l5 4z"></path><path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path><path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path></svg>';
        const crossed = (e: MouseEvent, player: Element) => {
          const r = e.relatedTarget;
          return !(r instanceof Element && player.contains(r));
        };
        document.addEventListener('mouseover', (e) => {
          const t = e.target;
          if (!(t instanceof Element)) return;
          const player = t.closest('[data-player]');
          if (!player || !crossed(e, player)) return;
          const video = player.querySelector('video');
          if (video) { const p = video.play(); if (p && p.catch) p.catch(() => {}); }
        });
        document.addEventListener('mouseout', (e) => {
          const t = e.target;
          if (!(t instanceof Element)) return;
          const player = t.closest('[data-player]');
          if (!player || !crossed(e, player)) return;
          const video = player.querySelector('video');
          if (video) { video.pause(); try { video.currentTime = 0; } catch (_) {} }
        });
        document.addEventListener('focusin', (e) => {
          const t = e.target;
          if (!(t instanceof Element)) return;
          const player = t.closest('[data-player]');
          if (!player) return;
          const video = player.querySelector('video');
          if (video) { const p = video.play(); if (p && p.catch) p.catch(() => {}); }
        });
        document.addEventListener('focusout', (e) => {
          const t = e.target;
          if (!(t instanceof Element)) return;
          const player = t.closest('[data-player]');
          if (!player) return;
          const video = player.querySelector('video');
          if (video) { video.pause(); try { video.currentTime = 0; } catch (_) {} }
        });
        document.addEventListener('click', (e) => {
          const t = e.target;
          if (!(t instanceof Element)) return;
          const btn = t.closest('[data-sound]');
          if (!btn) return;
          e.stopPropagation();
          const player = btn.closest('[data-player]');
          const video = player && player.querySelector('video');
          if (!video) return;
          const nextMuted = !video.muted;
          video.muted = nextMuted;
          btn.setAttribute('aria-pressed', String(!nextMuted));
          btn.setAttribute('aria-label', nextMuted ? 'Turn sound on' : 'Turn sound off');
          const icon = btn.querySelector('[data-sound-icon]');
          if (icon) icon.innerHTML = nextMuted ? SPEAKER_MUTED : SPEAKER_ON;
        });
        document.addEventListener('touchstart', (e) => {
          const t = e.target;
          if (!(t instanceof Element)) return;
          const player = t.closest('[data-player]');
          if (!player) return;
          if (t.closest('[data-sound]')) return;
          const video = player.querySelector('video');
          if (!video) return;
          if (video.paused) {
            const p = video.play(); if (p && p.catch) p.catch(() => {});
          } else {
            video.pause(); try { video.currentTime = 0; } catch (_) {}
          }
        }, { passive: true });

        // baseline-grid easter egg: "g" toggles a faint overlay of the leading
        // grid, anchored so the lines sit exactly under the letters.
        // session-scoped so it survives view-transition navigations.
        const gridOn = () => {
          try { return sessionStorage.getItem('emdw-grid') === '1'; } catch { return false; }
        };
        const placeGrid = () => {
          const grid = document.querySelector('.baseline-grid') as HTMLElement | null;
          if (!grid) return;
          const hide = !gridOn();
          grid.toggleAttribute('hidden', hide);
          if (hide) return;
          // a zero-size inline probe's bottom sits exactly on the text baseline
          const ref = document.querySelector('main h1, main p') || document.body;
          const probe = document.createElement('span');
          probe.style.cssText =
            'display:inline-block;width:0;height:0;margin:0;padding:0;border:0;vertical-align:baseline';
          ref.insertBefore(probe, ref.firstChild);
          const baseline = probe.getBoundingClientRect().top + window.scrollY;
          probe.remove();
          const pitch = parseFloat(getComputedStyle(document.body).lineHeight);
          if (!pitch) return;
          // line's top edge on the baseline, snapped to the device-pixel grid
          // so every hairline renders crisp instead of smearing across two
          const dpr = window.devicePixelRatio || 1;
          const phase = Math.round((((baseline % pitch) + pitch) % pitch) * dpr) / dpr;
          grid.style.setProperty('--grid-pitch', `${pitch}px`);
          grid.style.setProperty('--grid-phase', `${Math.min(phase, pitch - 1)}px`);
        };
        document.addEventListener('keydown', (e) => {
          if (e.key !== 'g' || e.metaKey || e.ctrlKey || e.altKey) return;
          const t = e.target as HTMLElement | null;
          if (t && t.closest('input, textarea, select, [contenteditable]')) return;
          try { sessionStorage.setItem('emdw-grid', gridOn() ? '0' : '1'); } catch {}
          placeGrid();
        });
        // the overlay div is re-rendered on every (SPA) navigation -- re-apply;
        // re-measure on resize because the root font-size is fluid
        document.addEventListener('astro:page-load', placeGrid);
        window.addEventListener('resize', placeGrid);
        placeGrid();
      }
    </script>
  </body>
</html>
